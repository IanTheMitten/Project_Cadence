# ESP-IDF build output — regenerated by `idf.py build`, one per project
build/
mic_test/build/
voice_chat/build/
voice_chat/managed_components/
lamp/build/
lamp/managed_components/

# Generated, machine-specific full configs (see CLAUDE.md)
sdkconfig
sdkconfig.old
mic_test/sdkconfig
mic_test/sdkconfig.old
voice_chat/sdkconfig
voice_chat/sdkconfig.old
lamp/sdkconfig
lamp/sdkconfig.old

# Contain the WiFi password in plaintext. voice_chat/ commits its sdkconfig.defaults
# (no secrets) and keeps credentials in the ignored sdkconfig.defaults.local.
sdkconfig.defaults
mic_test/sdkconfig.defaults
sdkconfig.defaults.local
mic_test/sdkconfig.defaults.local
voice_chat/sdkconfig.defaults.local
!voice_chat/sdkconfig.defaults
lamp/sdkconfig.defaults.local
!lamp/sdkconfig.defaults

# Python
tools/.venv/
__pycache__/
*.pyc

# Model weights — large, and fetched by the setup steps in
# tools/voice_chat_host.py's docstring rather than committed
tools/*.onnx
tools/voices-*.bin

# macOS
.DS_Store
