menu "Voice Chat"

    config VOICE_WIFI_SSID
        string "WiFi SSID"
        default ""
        help
            Home WiFi network the ESP32-S3 should join to reach
            tools/voice_chat_host.py.

    config VOICE_WIFI_PASSWORD
        string "WiFi password"
        default ""
        help
            Password for VOICE_WIFI_SSID.

    config VOICE_WS_URL
        string "Cadence session WebSocket URL"
        default "ws://ianshomeserver:8768/session"
        help
            URL of the harness's /session WebSocket endpoint
            (tools/voice_chat_host.py's successor). Carries the
            hello handshake, mic PCM upload, and playback PCM
            download over one bidirectional connection.

    config VOICE_CLIENT_ID
        string "Client ID"
        default "speaker-1"
        help
            Identifies this board in the hello frame sent on
            WebSocket connect.

endmenu
